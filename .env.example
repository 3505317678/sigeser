
DJANGO_SECRET_KEY=cambie-esta-clave-por-un-valor-aleatorio-largo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Ponga 1 solo si el sistema se publica con HTTPS (activa cookies Secure y HSTS).
DJANGO_USAR_HTTPS=0
SESSION_MINUTOS_INACTIVIDAD=30
EMPRESA_NOMBRE="Servicio Técnico SIGESER"

# --- PostgreSQL ---
POSTGRES_DB=sigeser
POSTGRES_USER=sigeser
POSTGRES_PASSWORD=cambie-esta-contrasena-de-base-de-datos

# --- Administrador inicial (se crea solo la primera vez) ---
SIGESER_ADMIN_CORREO=admin@sigeser.local
SIGESER_ADMIN_NOMBRE="Administrador SIGESER"
# Mínimo 12 caracteres. Cámbiela desde la aplicación después del primer ingreso.
SIGESER_ADMIN_CONTRASENA=cambie-esta-contrasena-de-administrador

# --- Datos de demostración (opcional) ---
# 1 = carga usuarios por rol, clientes, inventario y 70 órdenes en todos los estados (solo si no hay órdenes).
SIGESER_CARGAR_DEMO=1
SIGESER_DEMO_CONTRASENA=cambie-esta-contrasena-de-demostracion

# --- Puerto local de la aplicación ---
SIGESER_PUERTO=8080
